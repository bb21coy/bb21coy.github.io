<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<styleSheet
	xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"
	xmlns:vt="http://schemas.openxmlformats.org/officeDocument/2006/docPropsVTypes">
	<numFmts count="3">
		<numFmt numFmtId="56" formatCode="&quot;上午/下午 &quot;hh&quot;時&quot;mm&quot;分&quot;ss&quot;秒 &quot;"/>
	
        <!-- parade dates -->
        <numFmt numFmtId="165" formatCode="dd/mmm"/>

        <!-- date updated -->
        <numFmt numFmtId="166" formatCode="dd mmm yy"/>
    </numFmts>
	<fonts count="6">
		<font>
			<sz val="12"/>
			<color rgb="FF000000"/>
			<name val="Calibri"/>
			<family val="2"/>
		</font>

        <!-- platoon -->
        <font>
            <b/>
            <u/>
            <sz val="28"/>
            <color rgb="FF000000"/>
            <name val="Calibri"/>
            <family val="2"/>
        </font>

        <!-- year -->
        <font>
            <b/>
            <sz val="28"/>
            <color rgb="FFFFFF00"/>
            <name val="Calibri"/>
            <family val="2"/>
        </font>

        <!-- user details header -->
        <font>
            <b/>
            <sz val="11"/>
            <color rgb="FF000000"/>
            <name val="Calibri"/>
            <family val="2"/>
        </font>

        <!-- users -->
        <font>
            <sz val="11"/>
            <color rgb="FF000000"/>
            <name val="Calibri"/>
            <family val="2"/>
        </font>

        <!-- parade date -->
        <font>
            <sz val="11"/>
            <color rgb="FFFFFFFF"/>
            <name val="Calibri"/>
            <family val="2"/>
        </font>
	</fonts>
	<fills count="5">
		<fill>
			<patternFill patternType="none"/>
		</fill>
		<fill>
			<patternFill patternType="gray125"/>
		</fill>

        <!-- year -->
        <fill>
            <patternFill patternType="solid">
                <fgColor rgb="FF153C7C"/>
                <bgColor indexed="64"/>
            </patternFill>
        </fill>

        <!-- user details header -->
        <fill>
            <patternFill patternType="solid">
                <fgColor rgb="FFCDCDCD"/>
                <bgColor indexed="64"/>
            </patternFill>
        </fill>

        <!-- parade dates -->
        <fill>
            <patternFill patternType="solid">
                <fgColor rgb="3E629A"/>
                <bgColor indexed="64"/>
            </patternFill>
        </fill>
	</fills>
	<borders count="3">
		<border>
			<left/>
			<right/>
			<top/>
			<bottom/>
			<diagonal/>
		</border>

        <!-- all black border -->
        <border>
            <left style="thin">
                <color rgb="FF000000"/>
            </left>
            <right style="thin">
                <color rgb="FF000000"/>
            </right>
            <top style="thin">
                <color rgb="FF000000"/>
            </top>
            <bottom style="thin">
                <color rgb="FF000000"/>
            </bottom>
        </border>

        <!-- top black border -->
        <border>
            <top style="thin">
                <color rgb="FF000000"/>
            </top>
        </border>
	</borders>
	<cellStyleXfs count="1">
		<xf numFmtId="0" fontId="0" fillId="0" borderId="0"/>
	</cellStyleXfs>
	<cellXfs count="14">
		<!-- default -->
        <xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0"/>
        
        <!-- title -->
        <xf numFmtId="0" fontId="1" fillId="0" borderId="0" xfId="0" applyFont="1">
            <alignment vertical="center"/>
        </xf>

        <!-- year -->
        <xf numFmtId="0" fontId="2" fillId="2" borderId="1" xfId="0" applyFont="1" applyFill="1">
            <alignment vertical="center" horizontal="center"/>
        </xf>

        <!-- user details header -->
        <xf numFmtId="0" fontId="3" fillId="3" borderId="1" xfId="0" applyFont="1" applyFill="1">
            <alignment vertical="center" horizontal="center" wrapText="1"/>
        </xf>
        <xf numFmtId="0" fontId="3" fillId="3" borderId="1" xfId="0" applyFont="1" applyFill="1">
            <alignment vertical="center"/>
        </xf>

        <!-- users -->
        <xf numFmtId="0" fontId="4" fillId="0" borderId="1" xfId="0" applyFont="1"/>
        <xf numFmtId="0" fontId="4" fillId="0" borderId="1" xfId="0" applyFont="1">
            <alignment vertical="center" horizontal="center"/>
        </xf>

        <!-- parade date -->
        <xf numFmtId="165" fontId="5" fillId="4" borderId="1" xfId="0" applyFill="1" applyFont="1">
            <alignment vertical="center" horizontal="center"/>
        </xf>

        <!-- batch -->
        <xf numFmtId="0" fontId="5" fillId="2" borderId="1" xfId="0" applyFill="1" applyFont="1">
            <alignment vertical="center"/>
        </xf>

        <!-- attendance per parade -->
        <xf numFmtId="0" fontId="4" fillId="0" borderId="2" xfId="0" applyFont="1" applyBorder="1">
            <alignment vertical="center" horizontal="center"/>
        </xf>

        <!-- stats below -->
        <xf numFmtId="0" fontId="4" fillId="0" borderId="0" xfId="0" applyFont="1">
            <alignment vertical="center" horizontal="right"/>
        </xf>
        <xf numFmtId="0" fontId="4" fillId="0" borderId="0" xfId="0" applyFont="1">
            <alignment vertical="center" horizontal="center"/>
        </xf>
        <xf numFmtId="0" fontId="4" fillId="0" borderId="0" xfId="0" applyFont="1">
            <alignment vertical="center" horizontal="left"/>
        </xf>

        <!-- date updated -->
        <xf numFmtId="166" fontId="4" fillId="0" borderId="0" xfId="0" applyFont="1">
            <alignment vertical="center" horizontal="left"/>
        </xf>
	</cellXfs>
	<cellStyles count="1">
		<cellStyle name="Normal" xfId="0" builtinId="0"/>
	</cellStyles>
	<dxfs count="0"/>
	<tableStyles count="0" defaultTableStyle="TableStyleMedium9" defaultPivotStyle="PivotStyleMedium4"/>
</styleSheet>