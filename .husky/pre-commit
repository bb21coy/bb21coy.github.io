#!/bin/sh
# Tells the computer to run this script using the sh shell.

# Fetch the latest frontend branch silently
git fetch origin frontend >/dev/null 2>&1

# Get the latest commit on origin/frontend
frontend=$(git rev-parse origin/frontend)

# Get the common history of your branch and origin/frontend
# If this equals frontend → you have the latest changes
# If not → your branch is behind frontend and needs a pull/rebase
BASE=$(git merge-base HEAD origin/frontend)

# If BASE is not equal to frontend, your branch does not contain the latest frontend changes
if [ "$BASE" != "$frontend" ]; then
    echo "WARNING: Your branch is behind origin/frontend."
    echo "Please run: git pull origin frontend --rebase"
    echo "Commit aborted."
    exit 1
fi

echo "Your branch contains the latest origin/frontend. Proceeding with commit..."